<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RECICLA! — Parque da Reciclagem</title>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { background: #000; overflow: hidden; font-family: 'Press Start 2P', monospace; }
  canvas { display: block; }
  #gameCanvas { position: absolute; top: 0; left: 0; }
  .screen {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    background: rgba(0,10,5,0.88);
    z-index: 10;
    transition: opacity 0.4s;
  }
  .screen.hidden { opacity: 0; pointer-events: none; }
  .screen h1 {
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(18px, 4vw, 36px);
    color: #00ff88;
    text-shadow: 0 0 20px #00ff88, 0 0 40px #00aa55;
    margin-bottom: 16px;
    text-align: center;
  }
  .screen h2 {
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(12px, 2.5vw, 22px);
    color: #ffdd00;
    text-shadow: 0 0 10px #ffaa00;
    margin-bottom: 24px;
    text-align: center;
  }
  .screen p {
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(7px, 1.2vw, 11px);
    color: #aaffcc;
    margin: 4px 12px;
    text-align: center;
    line-height: 1.7;
    max-width: 600px;
  }
  .screen .btn {
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(10px, 1.8vw, 16px);
    color: #000;
    background: linear-gradient(180deg, #00ff88, #00aa55);
    border: none; border-radius: 8px;
    padding: 14px 32px; margin-top: 28px;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(0,255,136,0.5);
    transition: transform 0.1s, box-shadow 0.1s;
  }
  .screen .btn:hover { transform: scale(1.05); box-shadow: 0 6px 24px rgba(0,255,136,0.7); }
  .screen .btn:active { transform: scale(0.97); }
  .screen .score-display {
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(14px, 2.5vw, 22px);
    color: #ffd700;
    text-shadow: 0 0 12px #ffaa00;
    margin: 12px 0;
  }
  .bins-legend {
    display: flex; gap: 12px; margin: 14px 0; flex-wrap: wrap; justify-content: center;
  }
  .bin-item {
    display: flex; align-items: center; gap: 6px;
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(6px, 1vw, 9px);
    color: #fff;
  }
  .bin-dot { width: 14px; height: 14px; border-radius: 3px; }
</style>
</head>
<body>
<canvas id="gameCanvas"></canvas>

<div id="startScreen" class="screen">
  <h1>♻ RECICLA!</h1>
  <h2>Parque da Reciclagem</h2>
  <p>Arraste os itens para a lixeira correta!</p>
  <div class="bins-legend">
    <div class="bin-item"><div class="bin-dot" style="background:#4488ff"></div>Papel</div>
    <div class="bin-item"><div class="bin-dot" style="background:#ff3333"></div>Plástico</div>
    <div class="bin-item"><div class="bin-dot" style="background:#33cc66"></div>Vidro</div>
    <div class="bin-item"><div class="bin-dot" style="background:#ffcc00"></div>Metal</div>
    <div class="bin-item"><div class="bin-dot" style="background:#cc6600"></div>Orgânico</div>
  </div>
  <p>🛡️ ESCUDO — bloqueia perda de vida</p>
  <p>🔍 DICA — próximos 3 itens mostram seta</p>
  <p>💣 Bomba — não deixe chegar ao fundo!</p>
  <button class="btn" id="startBtn">JOGAR</button>
</div>

<div id="gameOverScreen" class="screen hidden">
  <h1>FIM DE JOGO</h1>
  <div class="score-display" id="finalScore">Pontuação: 0</div>
  <p id="finalPhase">Fase alcançada: 1</p>
  <p id="finalCombo"></p>
  <button class="btn" id="restartBtn">JOGAR NOVAMENTE</button>
</div>

<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');
const bgCanvas = document.createElement('canvas');
const bgCtx = bgCanvas.getContext('2d');

// ── helpers ───────────────────────────────────────────────────────────────────
function rrect(c, x, y, w, h, r) {
  if (typeof r === 'number') r = [r, r, r, r];
  const [tl, tr, br, bl] = r;
  c.beginPath();
  c.moveTo(x + tl, y);
  c.lineTo(x + w - tr, y);
  c.arcTo(x + w, y, x + w, y + tr, tr);
  c.lineTo(x + w, y + h - br);
  c.arcTo(x + w, y + h, x + w - br, y + h, br);
  c.lineTo(x + bl, y + h);
  c.arcTo(x, y + h, x, y + h - bl, bl);
  c.lineTo(x, y + tl);
  c.arcTo(x, y, x + tl, y, tl);
  c.closePath();
}
function hexToRgb(hex) {
  const r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
  return {r,g,b};
}
function shadeColor(hex, amt) {
  const {r,g,b} = hexToRgb(hex);
  const clamp = v => Math.max(0, Math.min(255, v));
  return `rgb(${clamp(r+amt)},${clamp(g+amt)},${clamp(b+amt)})`;
}
function seededRand(seed) {
  const x = Math.sin(seed + 1) * 10000;
  return x - Math.floor(x);
}
function lerp(a, b, t) { return a + (b - a) * t; }
function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }

// ── game data ─────────────────────────────────────────────────────────────────
const BINS_DEF = [
  { id:'paper',   label:'Papel',    color:'#4488ff', dark:'#1133aa', light:'#88aaff', emoji:'📄' },
  { id:'plastic', label:'Plástico', color:'#ff3333', dark:'#880000', light:'#ff8888', emoji:'🧴' },
  { id:'glass',   label:'Vidro',    color:'#33cc66', dark:'#115522', light:'#88ddaa', emoji:'🍾' },
  { id:'metal',   label:'Metal',    color:'#ffcc00', dark:'#775500', light:'#ffe066', emoji:'🥫' },
  { id:'organic', label:'Orgânico', color:'#cc6600', dark:'#442200', light:'#ee9944', emoji:'🍌' },
];
const ITEMS_DATA = [
  // paper
  { emoji:'📰', name:'Jornal',       bin:'paper',   phase:1 },
  { emoji:'📦', name:'Caixa',        bin:'paper',   phase:1 },
  { emoji:'📋', name:'Caderno',      bin:'paper',   phase:1 },
  { emoji:'🗞️',  name:'Revista',     bin:'paper',   phase:2 },
  { emoji:'📬', name:'Envelope',     bin:'paper',   phase:2 },
  { emoji:'🧻', name:'Rolo Papel',   bin:'paper',   phase:3 },
  { emoji:'📖', name:'Livro',        bin:'paper',   phase:3 },
  // plastic
  { emoji:'🧴', name:'Frasco',       bin:'plastic', phase:1 },
  { emoji:'🪣', name:'Balde',        bin:'plastic', phase:1 },
  { emoji:'🎈', name:'Balão',        bin:'plastic', phase:2 },
  { emoji:'🍼', name:'Mamadeira',    bin:'plastic', phase:2 },
  { emoji:'🪥', name:'Escova',       bin:'plastic', phase:2 },
  { emoji:'💿', name:'CD',           bin:'plastic', phase:3 },
  { emoji:'🧩', name:'Peça',         bin:'plastic', phase:3 },
  // glass
  { emoji:'🍾', name:'Garrafa',      bin:'glass',   phase:1 },
  { emoji:'🥛', name:'Leite',        bin:'glass',   phase:1 },
  { emoji:'🧪', name:'Tubo',         bin:'glass',   phase:2 },
  { emoji:'🪞', name:'Espelho',      bin:'glass',   phase:3 },
  { emoji:'🔭', name:'Luneta',       bin:'glass',   phase:3 },
  { emoji:'🏺', name:'Jarro',        bin:'glass',   phase:4 },
  // metal
  { emoji:'🥫', name:'Lata',         bin:'metal',   phase:1 },
  { emoji:'🔧', name:'Chave',        bin:'metal',   phase:1 },
  { emoji:'🔩', name:'Parafuso',     bin:'metal',   phase:2 },
  { emoji:'🪙', name:'Moeda',        bin:'metal',   phase:2 },
  { emoji:'🍴', name:'Talher',       bin:'metal',   phase:3 },
  { emoji:'⚙️',  name:'Engrenagem',  bin:'metal',   phase:3 },
  { emoji:'🔑', name:'Chave Casa',   bin:'metal',   phase:4 },
  // organic
  { emoji:'🍌', name:'Banana',       bin:'organic', phase:1 },
  { emoji:'🍎', name:'Maçã',         bin:'organic', phase:1 },
  { emoji:'🥕', name:'Cenoura',      bin:'organic', phase:1 },
  { emoji:'🌿', name:'Folha',        bin:'organic', phase:2 },
  { emoji:'☕', name:'Café',         bin:'organic', phase:2 },
  { emoji:'🥚', name:'Casca Ovo',    bin:'organic', phase:2 },
  { emoji:'🍞', name:'Pão',          bin:'organic', phase:3 },
  { emoji:'🌽', name:'Milho',        bin:'organic', phase:3 },
];
const PHASES_DEF = [
  null,
  { score:0,   maxItems:3, speed:0.30, spawnMs:4000 },
  { score:60,  maxItems:4, speed:0.55, spawnMs:2800 },
  { score:140, maxItems:5, speed:0.85, spawnMs:2000 },
  { score:250, maxItems:6, speed:1.30, spawnMs:1400 },
];
const POWERUPS_DEF = [
  { name:'ESCUDO', emoji:'🛡️', type:'shield', phase:2 },
  { name:'DICA',   emoji:'🔍', type:'hint',   phase:1 },
];
const SPECIALS_DEF = [
  { emoji:'💣', name:'Bomba',     type:'bomb',     phase:3, bin:null },
  { emoji:'🔋', name:'Bateria',   type:'battery',  phase:4, bin:null },
  { emoji:'💊', name:'Remédio',   type:'medicine', phase:4, bin:null },
];

// ── state ─────────────────────────────────────────────────────────────────────
let G = {};
let W = 0, H = 0;
let BIN_Y = 0, BIN_H = 0, BIN_W = 0, ITEM_SZ = 0;
let animId = null;
let lastTime = 0;
let mouseX = 0, mouseY = 0;

function resize() {
  W = canvas.width  = bgCanvas.width  = window.innerWidth;
  H = canvas.height = bgCanvas.height = window.innerHeight;
  BIN_H   = Math.min(H * 0.22, 140);
  BIN_W   = Math.min((W - 40) / 5 - 10, 110);
  BIN_Y   = H - BIN_H - Math.min(H * 0.04, 28);
  ITEM_SZ = Math.min(W * 0.09, 68);
  renderBackground();
  if (G.bins) layoutBins();
}

// ── background pre-render ─────────────────────────────────────────────────────
let treeData = [], buildingData = [], crackData = [];
function renderBackground() {
  const c = bgCtx;
  c.clearRect(0, 0, W, H);
  const horizonY = H * 0.52;

  // sky gradient
  const sky = c.createLinearGradient(0, 0, 0, horizonY);
  sky.addColorStop(0,    '#1a5fa8');
  sky.addColorStop(0.5,  '#87CEEB');
  sky.addColorStop(1,    '#b8e0f5');
  c.fillStyle = sky;
  c.fillRect(0, 0, W, horizonY + 2);

  // sun glow
  const sunX = W * 0.82, sunY = H * 0.10;
  const sunG = c.createRadialGradient(sunX, sunY, 2, sunX, sunY, W * 0.22);
  sunG.addColorStop(0,    'rgba(255,255,180,0.95)');
  sunG.addColorStop(0.15, 'rgba(255,220,80,0.6)');
  sunG.addColorStop(0.4,  'rgba(255,190,40,0.2)');
  sunG.addColorStop(1,    'rgba(255,160,0,0)');
  c.fillStyle = sunG;
  c.beginPath();
  c.arc(sunX, sunY, W * 0.22, 0, Math.PI * 2);
  c.fill();
  c.fillStyle = 'rgba(255,255,200,0.98)';
  c.beginPath(); c.arc(sunX, sunY, W * 0.028, 0, Math.PI * 2); c.fill();

  // buildings (seeded)
  buildingData = [];
  const nBuildings = 22;
  for (let i = 0; i < nBuildings; i++) {
    const t = i / nBuildings;
    const bx = t * W * 1.05 - W * 0.02 + seededRand(i * 7 + 1) * (W / nBuildings) * 0.6;
    const bh = H * (0.18 + seededRand(i * 7 + 2) * 0.30);
    const bw = W * 0.03 + seededRand(i * 7 + 3) * W * 0.04;
    buildingData.push({ x: bx, y: horizonY - bh, w: bw, h: bh });
  }
  buildingData.forEach((b, i) => {
    const bg = c.createLinearGradient(b.x, b.y, b.x + b.w, b.y);
    bg.addColorStop(0,   '#6E7E8E');
    bg.addColorStop(0.3, '#9BA8B5');
    bg.addColorStop(0.7, '#b0bec5');
    bg.addColorStop(1,   '#7a8c9a');
    c.fillStyle = bg;
    c.fillRect(b.x, b.y, b.w, b.h);
    // windows
    const wCols = Math.floor(b.w / 9);
    const wRows = Math.floor(b.h / 12);
    for (let wr = 0; wr < wRows; wr++) {
      for (let wc = 0; wc < wCols; wc++) {
        const wx = b.x + 4 + wc * 9;
        const wy = b.y + 6 + wr * 12;
        const lit = seededRand(i * 200 + wr * 20 + wc) > 0.45;
        c.fillStyle = lit ? 'rgba(255,250,180,0.82)' : 'rgba(30,40,60,0.7)';
        c.fillRect(wx, wy, 5, 7);
      }
    }
  });

  // grass
  const grass = c.createLinearGradient(0, horizonY, 0, H);
  grass.addColorStop(0,   '#5D8A2F');
  grass.addColorStop(0.3, '#4f7a28');
  grass.addColorStop(1,   '#4A7820');
  c.fillStyle = grass;
  c.fillRect(0, horizonY, W, H - horizonY);
  // grass texture lines
  c.strokeStyle = 'rgba(0,0,0,0.08)';
  c.lineWidth = 1;
  for (let gy = horizonY + 10; gy < H - BIN_H * 0.6; gy += 14) {
    c.beginPath(); c.moveTo(0, gy); c.lineTo(W, gy); c.stroke();
  }

  // pathway
  const pathY = H - BIN_H * 0.78;
  const path = c.createLinearGradient(0, pathY, 0, H);
  path.addColorStop(0,   '#C8B89A');
  path.addColorStop(0.5, '#b8a888');
  path.addColorStop(1,   '#A89878');
  c.fillStyle = path;
  c.fillRect(0, pathY, W, H - pathY);
  // path edge
  c.strokeStyle = 'rgba(100,80,40,0.4)';
  c.lineWidth = 2;
  c.beginPath(); c.moveTo(0, pathY); c.lineTo(W, pathY); c.stroke();
  // path cracks
  crackData = [];
  for (let ci = 0; ci < 18; ci++) {
    const cx = seededRand(ci * 31) * W;
    const cy = pathY + seededRand(ci * 31 + 1) * (H - pathY) * 0.9;
    const cl = 20 + seededRand(ci * 31 + 2) * 40;
    const ca = seededRand(ci * 31 + 3) * Math.PI;
    crackData.push({ x: cx, y: cy, l: cl, a: ca });
  }
  crackData.forEach(cr => {
    c.strokeStyle = 'rgba(80,60,30,0.18)';
    c.lineWidth = 1;
    c.beginPath();
    c.moveTo(cr.x, cr.y);
    c.lineTo(cr.x + Math.cos(cr.a) * cr.l, cr.y + Math.sin(cr.a) * cr.l);
    c.stroke();
  });

  // trees
  treeData = [];
  const nTrees = 13;
  for (let ti = 0; ti < nTrees; ti++) {
    const tx = (ti / (nTrees - 1)) * W * 0.96 + W * 0.02;
    const tGroundY = horizonY + seededRand(ti * 13 + 5) * (H * 0.08);
    const tH = H * 0.12 + seededRand(ti * 13 + 6) * H * 0.10;
    const tW = 6 + seededRand(ti * 13 + 7) * 6;
    const crownR = tH * 0.45 + seededRand(ti * 13 + 8) * tH * 0.2;
    treeData.push({ x: tx, groundY: tGroundY, h: tH, w: tW, r: crownR });
  }
  treeData.forEach((t, ti) => {
    // shadow
    c.fillStyle = 'rgba(0,0,0,0.14)';
    c.beginPath();
    c.ellipse(t.x + t.r * 0.3, t.groundY + 4, t.r * 0.7, t.r * 0.18, 0, 0, Math.PI * 2);
    c.fill();
    // trunk
    const trunkG = c.createLinearGradient(t.x - t.w / 2, 0, t.x + t.w / 2, 0);
    trunkG.addColorStop(0, '#4a2800');
    trunkG.addColorStop(0.4, '#7a4a1a');
    trunkG.addColorStop(1, '#3a1800');
    c.fillStyle = trunkG;
    c.fillRect(t.x - t.w / 2, t.groundY - t.h, t.w, t.h);
    // crown layers
    const crownY = t.groundY - t.h + t.r * 0.3;
    [
      { dx: t.r * 0.15, dy: t.r * 0.15, r: t.r * 0.85, col: '#2a5a10' },
      { dx: 0,          dy: 0,           r: t.r,         col: '#3a7a18' },
      { dx: -t.r * 0.2, dy: -t.r * 0.2, r: t.r * 0.6,   col: '#5aaa28' },
    ].forEach(layer => {
      c.fillStyle = layer.col;
      c.beginPath();
      c.arc(t.x + layer.dx, crownY + layer.dy, layer.r, 0, Math.PI * 2);
      c.fill();
    });
  });
}

// ── clouds ────────────────────────────────────────────────────────────────────
function initClouds() {
  G.clouds = [];
  for (let i = 0; i < 6; i++) {
    G.clouds.push({
      x: Math.random() * W,
      y: H * (0.04 + Math.random() * 0.18),
      speed: 0.12 + Math.random() * 0.18,
      scale: 0.6 + Math.random() * 0.8,
    });
  }
}
function drawCloud(c, x, y, scale) {
  c.save();
  c.fillStyle = 'rgba(255,255,255,0.88)';
  const r = 22 * scale;
  [[0,0],[r*0.7,-r*0.3],[r*1.4,0],[r*2.1,r*0.1],[r*0.35,r*0.25],[r*1.05,r*0.25]].forEach(([dx,dy]) => {
    c.beginPath(); c.arc(x + dx, y + dy, r * (0.6 + Math.random() * 0.01), 0, Math.PI * 2); c.fill();
  });
  c.restore();
}
function drawClouds() {
  G.clouds.forEach(cl => {
    drawCloud(ctx, cl.x, cl.y, cl.scale);
    cl.x += cl.speed;
    if (cl.x > W + 120) { cl.x = -140; cl.y = H * (0.04 + Math.random() * 0.18); }
  });
}

// ── bins layout ───────────────────────────────────────────────────────────────
function layoutBins() {
  const totalW = BINS_DEF.length * BIN_W + (BINS_DEF.length - 1) * 12;
  const startX = (W - totalW) / 2;
  G.bins = BINS_DEF.map((def, i) => ({
    ...def,
    x: startX + i * (BIN_W + 12),
    y: BIN_Y,
    w: BIN_W,
    h: BIN_H,
    slot: i,
  }));
}

// ── draw bin ──────────────────────────────────────────────────────────────────
function drawBin(bin, flash, arrowInfo) {
  const c = ctx;
  const { x, y, w, h, color, dark, light, emoji, label, slot } = bin;
  const t = performance.now() / 1000;

  // shadow
  c.save();
  c.fillStyle = 'rgba(0,0,0,0.22)';
  c.beginPath(); c.ellipse(x + w / 2, y + h + 6, w * 0.48, 8, 0, 0, Math.PI * 2); c.fill();

  // magnet glow
  if (G.perturbations.magnet && G.perturbations.magnet.slot === slot) {
    c.shadowColor = color; c.shadowBlur = 18 + Math.sin(t * 4) * 8;
  }

  // body gradient
  const bodyG = c.createLinearGradient(x, y, x + w, y);
  bodyG.addColorStop(0,    shadeColor(color, -55));
  bodyG.addColorStop(0.25, shadeColor(color, 20));
  bodyG.addColorStop(0.6,  shadeColor(color, 35));
  bodyG.addColorStop(1,    shadeColor(color, -40));
  c.fillStyle = bodyG;
  rrect(c, x, y, w, h, [4, 4, 14, 14]);
  c.fill();

  c.shadowBlur = 0;

  // vertical ribs
  [0.25, 0.5, 0.75].forEach(t => {
    c.strokeStyle = 'rgba(0,0,0,0.12)';
    c.lineWidth = 2;
    c.beginPath(); c.moveTo(x + w * t, y + 8); c.lineTo(x + w * t, y + h - 8); c.stroke();
  });

  // horizontal banding
  [0.3, 0.6].forEach(bt => {
    c.fillStyle = 'rgba(0,0,0,0.10)';
    c.fillRect(x + 2, y + h * bt, w - 4, h * 0.08);
  });

  // highlight strip
  c.fillStyle = 'rgba(255,255,255,0.18)';
  rrect(c, x + 3, y + 4, 7, h - 12, 3);
  c.fill();

  // lid
  const lidH = h * 0.13;
  const lidG = c.createLinearGradient(x - 4, y - lidH, x + w + 4, y);
  lidG.addColorStop(0,   shadeColor(color, -70));
  lidG.addColorStop(0.5, shadeColor(color, -30));
  lidG.addColorStop(1,   shadeColor(color, -60));
  c.fillStyle = lidG;
  rrect(c, x - 4, y - lidH, w + 8, lidH + 4, [6, 6, 2, 2]);
  c.fill();

  // slot
  c.fillStyle = 'rgba(0,0,0,0.75)';
  rrect(c, x + w * 0.28, y - lidH + 3, w * 0.44, lidH * 0.48, 2);
  c.fill();
  c.fillStyle = 'rgba(255,255,255,0.1)';
  rrect(c, x + w * 0.29, y - lidH + 3, w * 0.42, 2, 1);
  c.fill();

  // recycling symbol
  c.font = `${w * 0.40}px monospace`;
  c.textAlign = 'center';
  c.textBaseline = 'middle';
  c.fillStyle = 'rgba(0,0,0,0.2)';
  c.fillText('♻', x + w / 2 + 1, y + h * 0.38 + 1);
  c.fillStyle = 'rgba(255,255,255,0.82)';
  c.fillText('♻', x + w / 2, y + h * 0.38);

  // category emoji
  c.font = `${w * 0.26}px monospace`;
  c.fillText(emoji, x + w / 2, y + h * 0.62);

  // label background + text
  c.fillStyle = 'rgba(0,0,0,0.45)';
  rrect(c, x + 2, y + h - 20, w - 4, 18, [0, 0, 12, 12]);
  c.fill();
  c.fillStyle = '#fff';
  c.font = `bold ${Math.max(7, w * 0.095)}px 'Press Start 2P', monospace`;
  c.fillText(label, x + w / 2, y + h - 10);

  // flash overlay
  if (flash && flash.t > 0) {
    const alpha = flash.t * 0.55;
    c.fillStyle = flash.correct ? `rgba(0,255,80,${alpha})` : `rgba(255,40,40,${alpha})`;
    rrect(c, x, y, w, h, [4, 4, 14, 14]);
    c.fill();
    if (!flash.correct) {
      c.strokeStyle = `rgba(255,80,80,${alpha})`;
      c.lineWidth = 3;
      rrect(c, x - 2, y - 2, w + 4, h + 4, [6, 6, 16, 16]);
      c.stroke();
    }
  }

  // magnet icon
  if (G.perturbations.magnet && G.perturbations.magnet.slot === slot) {
    c.font = `${w * 0.28}px monospace`;
    c.fillText('🧲', x + w - w * 0.18, y + 14);
  }

  // arrow hint above bin
  if (arrowInfo && arrowInfo.arrow && arrowInfo.arrowT > 0) {
    const pulse = 0.6 + 0.4 * Math.sin(t * 8);
    c.globalAlpha = arrowInfo.arrowT * pulse;
    c.font = `${w * 0.45}px monospace`;
    c.textAlign = 'center';
    c.fillStyle = '#ffee00';
    c.shadowColor = '#ff8800'; c.shadowBlur = 10;
    c.fillText('⬇', x + w / 2, y - lidH - 12);
    c.shadowBlur = 0;
    c.globalAlpha = 1;
  }

  c.restore();
}

// ── draw item ─────────────────────────────────────────────────────────────────
function drawItem(item) {
  const c = ctx;
  const { x, y, emoji, name, binDef, sz, dragging, ghost, accel, special, powerup, hintArrow } = item;
  const t = performance.now() / 1000;
  const s = sz || ITEM_SZ;
  const ix = x - s / 2, iy = y - s / 2;

  c.save();

  if (dragging) { c.shadowColor = 'rgba(0,0,0,0.55)'; c.shadowBlur = 18; }

  // card background
  let cardAlpha = 0.82;
  if (ghost) { cardAlpha = 0.45 + 0.3 * Math.sin(t * 4); }

  let fillColor = 'rgba(240,240,255,0.85)';
  if (binDef) {
    const { r, g, b } = hexToRgb(binDef.color);
    fillColor = `rgba(${r},${g},${b},0.18)`;
  }
  c.globalAlpha = cardAlpha;
  rrect(c, ix, iy, s, s, 8);
  c.fillStyle = fillColor;
  c.fill();

  // border
  let borderColor = binDef ? binDef.color : '#888';
  let borderWidth = 2;
  if (special === 'bomb') {
    const pulse = 0.5 + 0.5 * Math.sin(t * 5);
    borderColor = `rgba(255,${Math.floor(80 + pulse * 80)},0,${0.7 + pulse * 0.3})`;
    borderWidth = 2.5;
  } else if (special === 'battery' || special === 'medicine') {
    const pulse = 0.5 + 0.5 * Math.sin(t * 6);
    borderColor = `rgba(220,0,${Math.floor(200 + pulse * 55)},${0.7 + pulse * 0.3})`;
    borderWidth = 2.5;
  } else if (powerup === 'shield') {
    const pulse = 0.5 + 0.5 * Math.sin(t * 5);
    borderColor = `rgba(0,${Math.floor(200 + pulse * 55)},255,${0.7 + pulse * 0.3})`;
    borderWidth = 2.5;
  } else if (powerup === 'hint') {
    const pulse = 0.5 + 0.5 * Math.sin(t * 5);
    borderColor = `rgba(255,${Math.floor(200 + pulse * 55)},0,${0.7 + pulse * 0.3})`;
    borderWidth = 2.5;
  }
  c.strokeStyle = borderColor;
  c.lineWidth = borderWidth;
  rrect(c, ix, iy, s, s, 8);
  c.stroke();

  // inner top shadow
  c.fillStyle = 'rgba(0,0,0,0.08)';
  c.fillRect(ix + 2, iy + 2, s - 4, s * 0.18);

  c.shadowBlur = 0;

  // ghost overlay
  if (ghost) {
    c.fillStyle = 'rgba(80,120,255,0.22)';
    rrect(c, ix, iy, s, s, 8);
    c.fill();
  }

  // emoji
  c.globalAlpha = cardAlpha;
  c.font = `${s * 0.52}px monospace`;
  c.textAlign = 'center';
  c.textBaseline = 'middle';
  c.fillText(emoji, x, y - s * 0.04);

  // accel marks
  if (accel) {
    c.font = `${s * 0.22}px monospace`;
    c.fillText('⚡', ix + s * 0.12, iy + s * 0.15);
    c.fillStyle = 'rgba(255,80,0,0.75)';
    c.fillRect(ix, iy, 5, 5);
    c.fillRect(ix + s - 5, iy, 5, 5);
  }

  // name label when dragging or hint
  if (dragging || hintArrow) {
    c.globalAlpha = 0.92;
    c.font = `bold ${Math.max(7, s * 0.12)}px 'Press Start 2P', monospace`;
    c.fillStyle = '#fff';
    c.textAlign = 'center';
    c.textBaseline = 'top';
    c.fillText(name, x, iy + s * 0.82);
  }

  // hint arrow
  if (hintArrow && item.hintBin !== undefined) {
    const targetBin = G.bins[item.hintBin];
    if (targetBin) {
      const ax = targetBin.x + targetBin.w / 2;
      const ay = targetBin.y - 28;
      c.globalAlpha = 0.8 + 0.2 * Math.sin(t * 4);
      c.font = `${s * 0.38}px monospace`;
      c.textAlign = 'center';
      c.textBaseline = 'middle';
      c.fillStyle = '#ffe600';
      c.fillText('⬇', ax, ay);
    }
  }

  // special tooltip for battery/medicine near top
  if ((special === 'battery' || special === 'medicine') && y < H * 0.25) {
    c.globalAlpha = 0.9;
    const txt = 'JOGUE PARA CIMA!';
    c.font = `bold ${Math.max(6, s * 0.13)}px 'Press Start 2P', monospace`;
    const tw = c.measureText(txt).width;
    c.fillStyle = 'rgba(200,0,200,0.75)';
    rrect(c, x - tw / 2 - 6, iy - 24, tw + 12, 18, 4);
    c.fill();
    c.fillStyle = '#fff';
    c.textAlign = 'center';
    c.textBaseline = 'middle';
    c.fillText(txt, x, iy - 15);
  }

  c.globalAlpha = 1;
  c.restore();
}

// ── particles ─────────────────────────────────────────────────────────────────
function spawnParticles(x, y, color, count) {
  for (let i = 0; i < count; i++) {
    const angle = Math.random() * Math.PI * 2;
    const speed = 1.5 + Math.random() * 3.5;
    G.particles.push({
      x, y,
      vx: Math.cos(angle) * speed,
      vy: Math.sin(angle) * speed - 2,
      life: 1,
      decay: 0.025 + Math.random() * 0.025,
      color,
      r: 3 + Math.random() * 4,
    });
  }
}

function spawnScorePopup(x, y, text, color) {
  G.scorePopups.push({ x, y, text, color: color || '#fff', life: 1, vy: -1.2 });
}

// ── item spawning ─────────────────────────────────────────────────────────────
function getPhaseItems(phase) {
  return ITEMS_DATA.filter(it => it.phase <= phase);
}

function pickSpawnX() {
  const margin = ITEM_SZ * 0.8;
  for (let attempt = 0; attempt < 5; attempt++) {
    const x = margin + Math.random() * (W - margin * 2);
    const tooClose = G.items.some(it => Math.abs(it.x - x) < ITEM_SZ * 1.2);
    if (!tooClose) return x;
  }
  return ITEM_SZ + Math.random() * (W - ITEM_SZ * 2);
}

function spawnItem() {
  const phase = G.phase;
  const pd = PHASES_DEF[phase];
  if (!pd || G.items.length >= pd.maxItems) return;

  // determine what to spawn
  const roll = Math.random();
  let spawned = null;

  // power-ups (5% each if phase ok)
  if (roll < 0.05 && phase >= 1) {
    const pu = POWERUPS_DEF[Math.floor(Math.random() * POWERUPS_DEF.length)];
    if (phase >= pu.phase) {
      const binDef = BINS_DEF[Math.floor(Math.random() * BINS_DEF.length)];
      spawned = {
        x: pickSpawnX(), y: -ITEM_SZ,
        emoji: pu.emoji, name: pu.name,
        bin: null, binDef,
        speed: pd.speed * (0.8 + Math.random() * 0.4),
        ghost: false, accel: false,
        powerup: pu.type, special: null,
        hintArrow: false, hintBin: null,
        id: G.nextId++,
      };
    }
  }
  // specials
  if (!spawned && roll < 0.12 && phase >= 3) {
    const eligible = SPECIALS_DEF.filter(s => phase >= s.phase);
    if (eligible.length) {
      const sp = eligible[Math.floor(Math.random() * eligible.length)];
      const binDef = BINS_DEF[Math.floor(Math.random() * BINS_DEF.length)];
      spawned = {
        x: pickSpawnX(), y: -ITEM_SZ,
        emoji: sp.emoji, name: sp.name,
        bin: null, binDef,
        speed: pd.speed * (0.7 + Math.random() * 0.3),
        ghost: Math.random() < 0.15,
        accel: Math.random() < 0.1,
        powerup: null, special: sp.type,
        hintArrow: false, hintBin: null,
        id: G.nextId++,
      };
    }
  }
  // normal
  if (!spawned) {
    const pool = getPhaseItems(phase);
    const def = pool[Math.floor(Math.random() * pool.length)];
    const binDef = BINS_DEF.find(b => b.id === def.bin);
    spawned = {
      x: pickSpawnX(), y: -ITEM_SZ,
      emoji: def.emoji, name: def.name,
      bin: def.bin, binDef,
      speed: pd.speed * (0.85 + Math.random() * 0.3),
      ghost: Math.random() < 0.08,
      accel: Math.random() < 0.08,
      powerup: null, special: null,
      hintArrow: false, hintBin: null,
      id: G.nextId++,
    };
    // hint power-up active?
    if (G.hintCount > 0) {
      spawned.hintArrow = true;
      spawned.hintBin = G.bins.findIndex(b => b.id === def.bin);
    }
  }
  if (spawned) {
    spawned.sz = ITEM_SZ;
    G.items.push(spawned);
  }
}

// ── perturbations ─────────────────────────────────────────────────────────────
function triggerPerturbation() {
  const phase = G.phase;
  const options = [];
  if (phase >= 2) options.push('wind', 'swap');
  if (phase >= 3) options.push('rain', 'magnet');
  if (phase >= 4) options.push('blackout');
  if (!options.length) return;
  const type = options[Math.floor(Math.random() * options.length)];
  const now = performance.now();

  if (type === 'wind') {
    G.perturbations.wind = {
      force: (Math.random() - 0.5) * 1.4,
      endTime: now + 5000,
    };
  } else if (type === 'swap') {
    const a = Math.floor(Math.random() * 5);
    let b = Math.floor(Math.random() * 5);
    while (b === a) b = Math.floor(Math.random() * 5);
    // animate swap
    G.perturbations.swap = { a, b, progress: 0, endTime: now + 3000 };
    G.swapTarget = { a, b };
  } else if (type === 'rain') {
    G.perturbations.rain = { endTime: now + 6000 };
  } else if (type === 'magnet') {
    G.perturbations.magnet = {
      slot: Math.floor(Math.random() * 5),
      force: 0.8 + Math.random() * 0.6,
      endTime: now + 5000,
    };
  } else if (type === 'blackout') {
    G.perturbations.blackout = { endTime: now + 7000 };
  }
  G.nextPerturbTime = now + 8000 + Math.random() * 8000;
}

// ── HUD ───────────────────────────────────────────────────────────────────────
function drawHUD() {
  const c = ctx;
  const pad = 10;
  const hudH = 52;
  const hudW = Math.min(W - 20, 640);
  const hudX = (W - hudW) / 2;
  const hudY = 8;

  // HUD background
  c.save();
  c.fillStyle = 'rgba(0,20,10,0.82)';
  rrect(c, hudX, hudY, hudW, hudH, 10);
  c.fill();
  c.strokeStyle = '#00ff88';
  c.lineWidth = 1.5;
  rrect(c, hudX, hudY, hudW, hudH, 10);
  c.stroke();

  // lives
  const liveStr = '❤️'.repeat(G.lives) + '🖤'.repeat(Math.max(0, 3 - G.lives));
  c.font = `${Math.min(18, hudW * 0.038)}px monospace`;
  c.textAlign = 'left';
  c.textBaseline = 'middle';
  c.fillStyle = '#ff6666';
  c.fillText(liveStr, hudX + 14, hudY + hudH / 2 - 6);

  // shield indicator
  if (G.shieldActive) {
    c.font = `${Math.min(15, hudW * 0.03)}px monospace`;
    c.fillText('🛡️', hudX + 14, hudY + hudH / 2 + 12);
  }

  // score
  c.font = `bold ${Math.min(16, hudW * 0.033)}px 'Press Start 2P', monospace`;
  c.textAlign = 'center';
  c.fillStyle = '#ffd700';
  c.fillText(`${G.score}`, hudX + hudW / 2, hudY + hudH / 2 - 5);

  // phase
  c.font = `${Math.min(9, hudW * 0.018)}px 'Press Start 2P', monospace`;
  c.textAlign = 'right';
  c.fillStyle = '#00ff88';
  c.fillText(`FASE ${G.phase}`, hudX + hudW - 14, hudY + hudH / 2 - 6);

  // phase progress bar
  const nextPhase = PHASES_DEF[G.phase + 1];
  if (nextPhase) {
    const thisPhase = PHASES_DEF[G.phase];
    const range = nextPhase.score - thisPhase.score;
    const prog = clamp((G.score - thisPhase.score) / range, 0, 1);
    const bx = hudX + hudW * 0.55, by = hudY + hudH - 14, bw = hudW * 0.38;
    c.fillStyle = 'rgba(0,0,0,0.4)';
    rrect(c, bx, by, bw, 8, 3);
    c.fill();
    c.fillStyle = '#00ff88';
    rrect(c, bx, by, bw * prog, 8, 3);
    c.fill();
    c.font = `${Math.min(7, hudW * 0.014)}px 'Press Start 2P', monospace`;
    c.textAlign = 'right';
    c.fillStyle = '#aaffcc';
    c.fillText(`→F${G.phase + 1}`, hudX + hudW - 14, hudY + hudH - 9);
  }

  // combo
  if (G.combo >= 2) {
    const comboY = hudY + hudH + 6;
    c.font = `${Math.min(10, hudW * 0.02)}px 'Press Start 2P', monospace`;
    c.textAlign = 'center';
    const comboColor = G.combo >= 5 ? '#ff6600' : '#ffdd00';
    c.fillStyle = comboColor;
    const mult = G.combo >= 5 ? 3 : G.combo >= 3 ? 2 : 1;
    c.fillText(`COMBO x${mult} 🔥${G.combo}`, W / 2, comboY + 8);
  }

  // perturbation icons
  const perturbs = [];
  if (G.perturbations.wind) perturbs.push('💨');
  if (G.perturbations.swap) perturbs.push('🔄');
  if (G.perturbations.blackout) perturbs.push('🌑');
  if (G.perturbations.rain) perturbs.push('🌧️');
  if (G.perturbations.magnet) perturbs.push('🧲');
  if (perturbs.length) {
    c.font = `${Math.min(16, H * 0.025)}px monospace`;
    c.textAlign = 'left';
    c.textBaseline = 'top';
    perturbs.forEach((ic, i) => c.fillText(ic, 10 + i * 26, 8));
  }

  // dragged item name
  if (G.dragging) {
    const dname = G.dragging.name;
    c.font = `${Math.min(10, W * 0.02)}px 'Press Start 2P', monospace`;
    const tw = c.measureText(dname).width;
    const bx2 = W / 2 - tw / 2 - 10, by2 = hudY + hudH + 4;
    c.fillStyle = 'rgba(0,20,10,0.8)';
    rrect(c, bx2, by2, tw + 20, 20, 4);
    c.fill();
    c.strokeStyle = '#00ff88';
    c.lineWidth = 1;
    rrect(c, bx2, by2, tw + 20, 20, 4);
    c.stroke();
    c.fillStyle = '#fff';
    c.textAlign = 'center';
    c.textBaseline = 'middle';
    c.fillText(dname, W / 2, by2 + 10);
  }

  c.restore();
}

// ── phase transition message ──────────────────────────────────────────────────
function drawPhaseMsg() {
