// ── score popups ──────────────────────────────────────────────────────────────
function drawScorePopups() {
  const c = ctx;
  G.scorePopups = G.scorePopups.filter(p => p.life > 0);
  G.scorePopups.forEach(p => {
    c.save();
    c.globalAlpha = p.life;
    c.font = `bold ${Math.min(20, W * 0.035)}px 'Press Start 2P', monospace`;
    c.textAlign = 'center';
    c.textBaseline = 'middle';
    c.fillStyle = p.color;
    c.shadowColor = p.color;
    c.shadowBlur = 8;
    c.fillText(p.text, p.x, p.y);
    c.restore();
    p.y += p.vy;
    p.life -= 0.022;
  });
}

// ── particles draw ────────────────────────────────────────────────────────────
function drawParticles() {
  const c = ctx;
  G.particles = G.particles.filter(p => p.life > 0);
  G.particles.forEach(p => {
    c.save();
    c.globalAlpha = p.life;
    c.fillStyle = p.color;
    c.beginPath(); c.arc(p.x, p.y, p.r * p.life, 0, Math.PI * 2); c.fill();
    c.restore();
    p.x += p.vx; p.y += p.vy; p.vy += 0.12; p.life -= p.decay;
  });
}

// ── wind indicator ────────────────────────────────────────────────────────────
function drawWindIndicator() {
  if (!G.perturbations.wind) return;
  const c = ctx;
  const dir = G.perturbations.wind.force > 0 ? '→' : '←';
  const strength = Math.abs(G.perturbations.wind.force);
  c.save();
  c.font = `${Math.min(14, W * 0.025)}px 'Press Start 2P', monospace`;
  c.fillStyle = 'rgba(180,220,255,0.75)';
  c.textAlign = 'left';
  c.textBaseline = 'top';
  c.fillText(`💨${dir} ${strength.toFixed(1)}`, 10, H * 0.08);
  c.restore();
}

// ── blackout ──────────────────────────────────────────────────────────────────
function drawBlackout() {
  if (!G.perturbations.blackout) return;
  const c = ctx;
  const torchR = Math.min(W, H) * 0.18;
  const grad = c.createRadialGradient(mouseX, mouseY, torchR * 0.3, mouseX, mouseY, torchR);
  grad.addColorStop(0, 'rgba(0,0,0,0)');
  grad.addColorStop(1, 'rgba(0,0,0,0.96)');
  c.save();
  c.fillStyle = 'rgba(0,0,0,0.92)';
  c.fillRect(0, 0, W, H);
  c.globalCompositeOperation = 'destination-out';
  c.fillStyle = grad;
  c.fillRect(0, 0, W, H);
  c.restore();
}

// ── resolve item ──────────────────────────────────────────────────────────────
function resolveItem(item, targetBinIdx) {
  const bin = G.bins[targetBinIdx];
  const correct = item.bin === bin.id;
  const now = performance.now();

  if (item.special === 'bomb') {
    // bomb caught in any bin = bad
    if (G.shieldActive) {
      G.shieldActive = false;
      spawnScorePopup(item.x, item.y - 30, '🛡️ BLOQUEADO!', '#00ddff');
    } else {
      G.lives--;
      spawnParticles(item.x, item.y, '#ff4400', 20);
      spawnScorePopup(item.x, item.y - 30, '-1 VIDA 💣', '#ff4400');
    }
    G.binFlash[targetBinIdx] = { t: 1, correct: false };
    removeItem(item);
    checkGameOver();
    return;
  }

  if (item.special === 'battery' || item.special === 'medicine') {
    // throw upward to dispose = toss back; normally just penalize sorting
    if (G.shieldActive) {
      G.shieldActive = false;
      spawnScorePopup(item.x, item.y - 30, '🛡️ BLOQUEADO!', '#00ddff');
    } else {
      G.lives--;
      spawnScorePopup(item.x, item.y - 30, '-1 VIDA ☠️', '#cc00cc');
    }
    G.binFlash[targetBinIdx] = { t: 1, correct: false };
    removeItem(item);
    checkGameOver();
    return;
  }

  if (item.powerup === 'shield') {
    G.shieldActive = true;
    spawnScorePopup(item.x, item.y - 30, '🛡️ ESCUDO ATIVO!', '#00ddff');
    spawnParticles(item.x, item.y, '#00ddff', 12);
    G.binFlash[targetBinIdx] = { t: 1, correct: true };
    removeItem(item);
    return;
  }

  if (item.powerup === 'hint') {
    G.hintCount += 3;
    spawnScorePopup(item.x, item.y - 30, '🔍 +3 DICAS!', '#ffee00');
    spawnParticles(item.x, item.y, '#ffee00', 12);
    G.binFlash[targetBinIdx] = { t: 1, correct: true };
    removeItem(item);
    return;
  }

  if (correct) {
    G.combo++;
    if (G.hintCount > 0) G.hintCount--;
    const mult = G.combo >= 5 ? 3 : G.combo >= 3 ? 2 : 1;
    const pts = 10 * mult;
    G.score += pts;
    const popText = mult > 1 ? `+${pts} COMBO!` : `+${pts}`;
    const popColor = mult >= 3 ? '#ff6600' : mult === 2 ? '#ffdd00' : '#00ff88';
    spawnScorePopup(item.x, item.y - 30, popText, popColor);
    spawnParticles(item.x, item.y, bin.color, 16);
    G.binFlash[targetBinIdx] = { t: 1, correct: true };
    checkPhaseUp();
  } else {
    G.combo = 0;
    if (G.shieldActive) {
      G.shieldActive = false;
      spawnScorePopup(item.x, item.y - 30, '🛡️ BLOQUEADO!', '#00ddff');
    } else {
      G.score = Math.max(0, G.score - 5);
      G.lives--;
      spawnScorePopup(item.x, item.y - 30, '-5 ❌', '#ff4444');
    }
    G.binFlash[targetBinIdx] = { t: 1, correct: false };
    // show arrow on correct bin
    const correctSlot = G.bins.findIndex(b => b.id === item.bin);
    if (correctSlot >= 0) {
      G.binFlash[correctSlot] = G.binFlash[correctSlot] || {};
      G.binFlash[correctSlot].arrow = true;
      G.binFlash[correctSlot].arrowT = 1.0;
    }
    checkGameOver();
  }
  removeItem(item);
}

function removeItem(item) {
  G.items = G.items.filter(it => it.id !== item.id);
  if (G.dragging && G.dragging.id === item.id) G.dragging = null;
}

function checkPhaseUp() {
  const nextPhase = G.phase + 1;
  if (nextPhase <= 4 && PHASES_DEF[nextPhase] && G.score >= PHASES_DEF[nextPhase].score) {
    G.phase = nextPhase;
    G.phaseMsg = { text: `⬆ FASE ${G.phase}!`, life: 1 };
    triggerPerturbation();
  }
}

function checkGameOver() {
  if (G.lives <= 0) {
    G.lives = 0;
    G.running = false;
    showGameOver();
  }
}

function showGameOver() {
  document.getElementById('finalScore').textContent = `Pontuação: ${G.score}`;
  document.getElementById('finalPhase').textContent = `Fase alcançada: ${G.phase}`;
  document.getElementById('finalCombo').textContent = G.combo > 0 ? `Maior combo: ${G.combo}` : '';
  document.getElementById('gameOverScreen').classList.remove('hidden');
}

// ── swap animation ────────────────────────────────────────────────────────────
function updateSwap(dt) {
  const sw = G.perturbations.swap;
  if (!sw) return;
  sw.progress = Math.min(sw.progress + dt * 0.8, 1);
  if (performance.now() >= sw.endTime) {
    // finalize swap
    const { a, b } = G.swapTarget;
    const tmpX = G.bins[a].x, tmpY = G.bins[a].y;
    G.bins[a].x = G.bins[b].x; G.bins[a].y = G.bins[b].y;
    G.bins[b].x = tmpX; G.bins[b].y = tmpY;
    G.bins[a].slot = b; G.bins[b].slot = a;
    // swap in array
    const tmp = G.bins[a]; G.bins[a] = G.bins[b]; G.bins[b] = tmp;
    delete G.perturbations.swap;
    G.swapTarget = null;
  }
}

// ── main update ───────────────────────────────────────────────────────────────
function update(dt) {
  const now = performance.now();
  if (!G.running) return;

  // expire perturbations
  ['wind','rain','magnet','blackout'].forEach(k => {
    if (G.perturbations[k] && now >= G.perturbations[k].endTime) delete G.perturbations[k];
  });
  updateSwap(dt);

  // spawn
  const spawnInterval = G.perturbations.rain
    ? PHASES_DEF[G.phase].spawnMs / 2
    : PHASES_DEF[G.phase].spawnMs;
  if (now - G.lastSpawn >= spawnInterval) {
    spawnItem();
    G.lastSpawn = now;
  }

  // perturbation trigger
  if (now >= G.nextPerturbTime && G.phase >= 2) {
    triggerPerturbation();
  }

  // update bin flash timers
  G.binFlash.forEach((bf, i) => {
    if (bf) {
      if (bf.t > 0) bf.t -= dt * 2.5;
      if (bf.arrowT > 0) bf.arrowT -= dt / 1.5;
      if (bf.t <= 0 && (!bf.arrowT || bf.arrowT <= 0)) G.binFlash[i] = null;
    }
  });

  // update items
  const pd = PHASES_DEF[G.phase];
  G.items.forEach(item => {
    if (item === G.dragging) return;
    let speedMult = item.accel ? 1.6 : 1.0;
    item.y += item.speed * speedMult * 60 * dt;

    // wind
    if (G.perturbations.wind) {
      item.x += G.perturbations.wind.force * 60 * dt;
      item.x = clamp(item.x, ITEM_SZ / 2, W - ITEM_SZ / 2);
    }

    // magnet
    if (G.perturbations.magnet) {
      const mb = G.bins[G.perturbations.magnet.slot];
      if (mb) {
        const dx = (mb.x + mb.w / 2) - item.x;
        const dist = Math.abs(dx);
        if (dist < W * 0.35) {
          item.x += (dx / dist) * G.perturbations.magnet.force * 60 * dt;
        }
      }
    }

    // reached bin zone
    if (item.y >= BIN_Y - 10 && !item.resolved) {
      item.resolved = true;
      // find which bin it's over
      let bestBin = -1, bestDist = Infinity;
      G.bins.forEach((bin, idx) => {
        const cx = bin.x + bin.w / 2;
        const dist = Math.abs(item.x - cx);
        if (dist < bestDist) { bestDist = dist; bestBin = idx; }
      });
      if (bestBin >= 0 && bestDist < BIN_W * 0.9) {
        resolveItem(item, bestBin);
      } else {
        // missed all bins — penalize
        if (item.special === 'bomb') {
          if (G.shieldActive) {
            G.shieldActive = false;
            spawnScorePopup(item.x, BIN_Y - 40, '🛡️ BLOQUEADO!', '#00ddff');
          } else {
            G.lives--;
            spawnScorePopup(item.x, BIN_Y - 40, '-1 VIDA 💣', '#ff4400');
            checkGameOver();
          }
        } else if (!item.powerup && !item.special) {
          G.combo = 0;
          G.score = Math.max(0, G.score - 3);
          spawnScorePopup(item.x, BIN_Y - 40, '-3 PERDEU!', '#ff6666');
        }
        removeItem(item);
      }
    }
  });
}

// ── main draw ─────────────────────────────────────────────────────────────────
function draw() {
  ctx.clearRect(0, 0, W, H);
  ctx.drawImage(bgCanvas, 0, 0);
  drawClouds();
  drawRain();

  // bins
  G.bins.forEach((bin, i) => drawBin(bin, G.binFlash[i], G.binFlash[i]));

  // items
  G.items.forEach(item => {
    if (item !== G.dragging) drawItem(item);
  });
  if (G.dragging) drawItem(G.dragging);

  drawParticles();
  drawScorePopups();
  drawHUD();
  drawWindIndicator();
  drawPhaseMsg();
  drawBlackout();
}

// ── game loop ─────────────────────────────────────────────────────────────────
function loop(ts) {
  const dt = Math.min((ts - lastTime) / 1000, 0.05);
  lastTime = ts;
  update(dt);
  draw();
  animId = requestAnimationFrame(loop);
}

// ── input ─────────────────────────────────────────────────────────────────────
function getPos(e) {
  const rect = canvas.getBoundingClientRect();
  const scaleX = W / rect.width, scaleY = H / rect.height;
  if (e.touches) {
    return {
      x: (e.touches[0].clientX - rect.left) * scaleX,
      y: (e.touches[0].clientY - rect.top) * scaleY,
    };
  }
  return {
    x: (e.clientX - rect.left) * scaleX,
    y: (e.clientY - rect.top) * scaleY,
  };
}

function onPointerDown(e) {
  if (!G.running) return;
  const { x, y } = getPos(e);
  // find item under cursor (top-most)
  for (let i = G.items.length - 1; i >= 0; i--) {
    const item = G.items[i];
    if (item.resolved) continue;
    const dx = Math.abs(x - item.x), dy = Math.abs(y - item.y);
    if (dx < item.sz / 2 + 4 && dy < item.sz / 2 + 4) {
      G.dragging = item;
      G.dragOffX = item.x - x;
      G.dragOffY = item.y - y;
      break;
    }
  }
  e.preventDefault();
}

function onPointerMove(e) {
  const { x, y } = getPos(e);
  mouseX = x; mouseY = y;
  if (G.dragging) {
    G.dragging.x = x + G.dragOffX;
    G.dragging.y = y + G.dragOffY;
  }
  e.preventDefault();
}

function onPointerUp(e) {
  if (!G.dragging) return;
  const item = G.dragging;
  G.dragging = null;

  // check drop on bin
  let dropped = false;
  G.bins.forEach((bin, idx) => {
    const cx = bin.x + bin.w / 2;
    if (Math.abs(item.x - cx) < bin.w * 0.72 && item.y > bin.y - 20 && item.y < bin.y + bin.h + 10) {
      if (!item.resolved) {
        item.resolved = true;
        resolveItem(item, idx);
        dropped = true;
      }
    }
  });
  if (!dropped && !item.resolved) {
    item.dragging = false;
    // item continues falling
  }
  e.preventDefault();
}

canvas.addEventListener('mousedown',  onPointerDown, { passive: false });
canvas.addEventListener('mousemove',  onPointerMove, { passive: false });
canvas.addEventListener('mouseup',    onPointerUp,   { passive: false });
canvas.addEventListener('touchstart', onPointerDown, { passive: false });
canvas.addEventListener('touchmove',  onPointerMove, { passive: false });
canvas.addEventListener('touchend',   onPointerUp,   { passive: false });

// ── init / reset ──────────────────────────────────────────────────────────────
function initGame() {
  G = {
    running:       false,
    score:         0,
    lives:         3,
    phase:         1,
    combo:         0,
    shieldActive:  false,
    hintCount:     0,
    items:         [],
    particles:     [],
    scorePopups:   [],
    perturbations: {},
    binFlash:      Array(5).fill(null),
    dragging:      null,
    dragOffX:      0,
    dragOffY:      0,
    lastSpawn:     0,
    nextPerturbTime: performance.now() + 12000,
    phaseMsg:      null,
    swapTarget:    null,
    nextId:        1,
  };
  layoutBins();
  initClouds();
}

function startGame() {
  document.getElementById('startScreen').classList.add('hidden');
  document.getElementById('gameOverScreen').classList.add('hidden');
  initGame();
  G.running = true;
  G.lastSpawn = performance.now() - PHASES_DEF[1].spawnMs + 500;
  if (!animId) {
    lastTime = performance.now();
    animId = requestAnimationFrame(loop);
  }
}

document.getElementById('startBtn').addEventListener('click', startGame);
document.getElementById('restartBtn').addEventListener('click', () => {
  document.getElementById('gameOverScreen').classList.add('hidden');
  initGame();
  G.running = true;
  G.lastSpawn = performance.now() - PHASES_DEF[1].spawnMs + 500;
});

window.addEventListener('resize', resize);
resize();
// start loop so background and clouds render on start screen
lastTime = performance.now();
animId = requestAnimationFrame(loop);
</script>
