// ── rain streaks ──────────────────────────────────────────────────────────────
function drawRain() {
  if (!G.perturbations.rain) return;
  const c = ctx;
  c.save();
  c.strokeStyle = 'rgba(140,160,255,0.38)';
  c.lineWidth = 1;
  for (let i = 0; i < 30; i++) {
    const rx = seededRand(i * 7 + Math.floor(performance.now() / 80)) * W;
    const ry = seededRand(i * 7 + 1 + Math.floor(performance.now() / 80)) * H;
    c.beginPath();
    c.moveTo(rx, ry);
    c.lineTo(rx + 4, ry + 14);
    c.stroke();
  }
  c.restore();
